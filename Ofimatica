        function renderSessionsGrid(data) {
            const grid = document.getElementById('sessions-grid');
            grid.innerHTML = '';
            data.forEach(s => {
                const card = document.createElement('div');
                card.className = 'card card-interactive';
                card.onclick = () => openSessionDetail(s.id);
                card.innerHTML = `
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <span class="badge ${s.badge}">Sesión ${s.id < 10 ? '0' + s.id : s.id}</span>
                        <span style="font-size:0.8rem; color:var(--text-muted); font-weight:600;">${s.fecha}</span>
                    </div>
                    <h3 style="margin:0.5rem 0 0.25rem 0; font-size:1.05rem;">${s.titulo}</h3>
                    <p style="font-size:0.82rem; color:var(--text-muted); margin-bottom:0.5rem;">${s.desc}</p>
                    <div style="font-size:0.75rem; color:var(--text-muted); font-style:italic;">${s.ficha}</div>
                    <div style="margin-top:0.8rem; padding-top:0.5rem; border-top:1px solid var(--border); font-size:0.8rem; display:flex; justify-content:space-between; align-items:center;">
                        <span class="file-code">📄 ${s.doc}</span>
                        <span style="color:var(--primary); font-weight:600;">Ver Ficha →</span>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function renderSessionsTable(data) {
            const tbody = document.querySelector('#sessions-table tbody');
            tbody.innerHTML = '';
            data.forEach(s => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td><span class="badge ${s.badge}">Sesión ${s.id < 10 ? '0' + s.id : s.id}</span></td>
                    <td><strong>${s.fecha}</strong></td>
                    <td style="font-size:0.85rem;">${s.ficha}</td>
                    <td><strong>${s.titulo}</strong></td>
                    <td><span class="file-code">${s.doc}</span></td>
                    <td style="font-size:0.8rem;">${s.ce}</td>
                    <td><button style="padding:0.25rem 0.6rem; font-size:0.8rem; cursor:pointer;" onclick="openSessionDetail(${s.id})">Ver Ficha</button></td>
                `;
                tbody.appendChild(tr);
            });
        }

        function filterSessions(category) {
            document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');
            
            if (category === 'all') {
                currentFilteredSessions = [...sesionesData];
            } else {
                currentFilteredSessions = sesionesData.filter(s => s.bloque === category);
            }

            renderSessionsGrid(currentFilteredSessions);
            renderSessionsTable(currentFilteredSessions);
        }

        function toggleLayout(type) {
            const gridView = document.getElementById('sessions-grid');
            const tableView = document.getElementById('sessions-table-wrapper');
            const btnGrid = document.getElementById('btn-view-grid');
            const btnTable = document.getElementById('btn-view-table');

            if (type === 'grid') {
                gridView.style.display = 'grid';
                tableView.style.display = 'none';
                btnGrid.classList.add('active');
                btnTable.classList.remove('active');
            } else {
                gridView.style.display = 'none';
                tableView.style.display = 'block';
                btnGrid.classList.remove('active');
                btnTable.classList.add('active');
            }
        }

